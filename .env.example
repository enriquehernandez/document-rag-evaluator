# ==========================================
# CONFIGURACIÓN DEL LLM (Para responder al usuario)
# ==========================================
# Opciones: OPENAI, CLAUDE, GEMINI, GROQ, OPENROUTER
LLM_PROVIDER=GROQ

# OpenAI (Para LLM)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic Claude
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-haiku-20240307

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-pro

# Groq 
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/auto

# ==========================================
# CONFIGURACIÓN DE EMBEDDINGS
# ==========================================

# Usaremos OpenRouter para los embeddings
EMBEDDING_PROVIDER=OPENROUTER

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# El modelo de OpenAI que ofrece OpenRouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ==========================================
# CONFIGURACIÓN DE INGESTA
# ==========================================
# FULL: Borra la BD y procesa todos los PDFs desde cero.
# INCREMENTAL: Procesa solo los PDFs nuevos que no estén en la BD.
INGEST_MODE=INCREMENTAL
